# Copy to .env and fill in. Never commit .env or key files.
# Option 1: a named connection in ~/.snowflake/connections.toml
#   (https://docs.snowflake.com/en/developer-guide/snowflake-cli/connecting/configure-connections)
SNOWFLAKE_CONNECTION_NAME=plant_brain

# Option 2: explicit settings (account identifier = ORGNAME-ACCOUNTNAME, see 00_setup.sql output)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
# Key-pair auth (service user PB_SVC, see snowflake/00b_agent_user.sql) ...
SNOWFLAKE_PRIVATE_KEY_PATH=
# ... or browser SSO for your own user
SNOWFLAKE_AUTHENTICATOR=externalbrowser

SNOWFLAKE_ROLE=PB_ROLE
SNOWFLAKE_WAREHOUSE=PB_WH
SNOWFLAKE_DATABASE=PLANT_BRAIN
