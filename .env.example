# Copy to .env and fill in. Never commit .env.
# Preferred: configure a named connection in ~/.snowflake/connections.toml
# (see https://docs.snowflake.com/en/developer-guide/snowflake-cli/connecting/configure-connections)
# and just set SNOWFLAKE_CONNECTION_NAME.
SNOWFLAKE_CONNECTION_NAME=plant_brain

# Fallback if not using connections.toml
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_AUTHENTICATOR=externalbrowser
SNOWFLAKE_ROLE=PB_ROLE
SNOWFLAKE_WAREHOUSE=PB_WH
SNOWFLAKE_DATABASE=PLANT_BRAIN
